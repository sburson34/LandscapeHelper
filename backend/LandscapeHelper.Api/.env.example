# Required at runtime — set via env on the shared host's secrets/landscapehelper.env.

ConnectionStrings__Default=Host=<rds-endpoint>;Port=5432;Database=landscapehelper;Username=landscapehelper_app;Password=<pw>;SSL Mode=Require;Trust Server Certificate=true
Database__Provider=postgresql

Sentry__Dsn=https://<key>@<org>.ingest.sentry.io/<project>
Sentry__Environment=production

JWT_SIGNING_KEY=
OPENAI_API_KEY=

# Legacy: existing EB env reads JWT key from Secrets Manager when SECRET_ARN is set.
# On the shared host, leave SECRET_ARN empty so the app falls back to JWT_SIGNING_KEY env.
SECRET_ARN=
