<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-sburson34" value="https://nuget.pkg.github.com/sburson34/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <!-- GitHub's NuGet feed always requires auth, even for public packages.
         The auto-issued GITHUB_TOKEN can read public packages cross-repo. -->
    <github-sburson34>
      <add key="Username" value="sburson34" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-sburson34>
  </packageSourceCredentials>
</configuration>
